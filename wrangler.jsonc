{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Astro adapter fills in `main` and `assets` at build time.
  "name": "samuel-alonso-portfolio",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Unknown routes return dist/client/404.html with status 404 (without this the body is empty).
  "assets": { "not_found_handling": "404-page" },
  // Contact form (#39). Secrets via `wrangler secret put`: TURNSTILE_SECRET_KEY, RESEND_API_KEY.
  "vars": { "CONTACT_TO": "samuelalonsodev@gmail.com" },
  // 5 submissions per IP per minute.
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
}
