---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { PUBLIC_CF_BEACON_TOKEN as beaconToken } from 'astro:env/client';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader, { type Section } from '../components/SiteHeader.astro';
import { htmlLang, locales, ogLocale, type Locale } from '../i18n/config';
import { routes, type Paths } from '../i18n/routes';
import { t } from '../i18n/ui';
import { sha256Base64, THEME_INIT_SCRIPT } from '../lib/theme-init';

Astro.csp?.insertScriptHash(`sha256-${await sha256Base64(THEME_INIT_SCRIPT)}`);

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** The page in each locale. Absent (e.g. 404): no canonical, alternates or language switch. */
  paths?: Paths | undefined;
  noindex?: boolean | undefined;
  /** Field tone for pages that start on a color field (home). */
  tone?: 'ink' | 'petrol' | undefined;
  /** In-page sections linked from the header. */
  sections?: Section[] | undefined;
  /** Primary action in the header. */
  cta?: Section | undefined;
  /** Case pages: adds an Article to the JSON-LD. */
  article?: { headline: string } | undefined;
}

const {
  locale,
  title,
  description,
  paths,
  noindex = false,
  tone,
  sections,
  cta,
  article,
} = Astro.props;

const canonical = paths ? new URL(paths[locale], Astro.site).href : undefined;
const alternates = paths
  ? locales.map((l) => ({ hreflang: htmlLang[l], href: new URL(paths[l], Astro.site).href }))
  : [];
const xDefault = paths ? new URL(paths.es, Astro.site).href : undefined;

// Built after the pages by the og-images integration (src/lib/og.ts).
const ogImage = new URL(`/og/${locale}.png`, Astro.site).href;
const home = new URL(routes.home[locale], Astro.site).href;
const person = { '@id': new URL('/#person', Astro.site).href };
const graph = [
  {
    '@type': 'Person',
    ...person,
    name: 'Samuel Alonso Hernández',
    jobTitle: t(locale, 'meta.jobTitle'),
    address: { '@type': 'PostalAddress', addressLocality: 'Querétaro', addressCountry: 'MX' },
    url: home,
    sameAs: ['https://github.com/SamuelAlonso-debug'],
  },
  {
    '@type': 'WebSite',
    name: t(locale, 'meta.siteName'),
    url: home,
    inLanguage: htmlLang[locale],
    author: person,
  },
  ...(article
    ? [
        {
          '@type': 'Article',
          headline: article.headline,
          description,
          url: canonical,
          image: ogImage,
          inLanguage: htmlLang[locale],
          author: person,
        },
      ]
    : []),
];
// `<` escaped so content can never close the script element.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
  /</g,
  '\\u003c',
);
---

<!doctype html>
<html lang={htmlLang[locale]} data-tone={tone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f7f9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#13191e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, 'meta.siteName')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Samuel Alonso. ${t(locale, 'home.role')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-plex-mono" />

    <script is:inline set:html={THEME_INIT_SCRIPT} />
  </head>
  {/* The nav CTA starts neutral: the page that passes it opens on its own primary (contact.ts updates it). */}
  <body data-primary-visible={cta ? '' : undefined}>
    <a
      href="#content"
      class="sr-only rounded-sm bg-accent px-4 py-2 text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      {t(locale, 'a11y.skip')}
    </a>
    <SiteHeader locale={locale} paths={paths} sections={sections} cta={cta} />
    <main id="content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    {
      /* Cloudflare Web Analytics, cookieless. Inserted by hand so the CSP stays strict. */
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
  </body>
</html>
