---
/**
 * Sample wall of drawn product screens (SEA, MiniKernel, an incident) with fake data.
 * Replaced by real screenshots before launch (#50 deletes src/samples/).
 */
import ProductScreen from '../components/ProductScreen.astro';

const rows = [
  { item: 'Café de olla 1 kg', qty: 14, state: 'ok', label: 'Bien' },
  { item: 'Piloncillo 500 g', qty: 3, state: 'warn', label: 'Bajo' },
  { item: 'Canela en raja 250 g', qty: 27, state: 'ok', label: 'Bien' },
] as const;
---

<div id="hero-wall" class="wall" aria-hidden="true">
  <ProductScreen class="sea p-3.5">
    <header class="flex items-baseline justify-between gap-3 border-b border-black/8 pb-2.5">
      <b class="text-[1.2em]">SEA</b>
      <span class="flex gap-3 opacity-70">
        <b>Inventario</b>
        <span class="max-[359px]:hidden">Ventas</span>
        <span class="max-[359px]:hidden">Gastos</span>
        <span class="max-[359px]:hidden">Clientes</span>
      </span>
    </header>
    <div class="row opacity-70">
      <span>Producto</span>
      <span>Exist.</span>
      <span>Estado</span>
    </div>
    {rows.map((r) => (
      <div class="row">
        <span>{r.item}</span>
        <span>{r.qty}</span>
        <span class="inline-flex items-center gap-1.5">
          <svg
            viewBox="0 0 10 10"
            class:list={[
              'size-2',
              r.state === 'ok' ? 'text-[oklch(55%_0.13_150)]' : 'text-[oklch(60%_0.15_50)]',
            ]}
          >
            {r.state === 'ok' ? (
              <circle cx="5" cy="5" r="4.5" fill="currentColor" />
            ) : (
              <path d="M5 .5 9.5 9.5H.5Z" fill="currentColor" />
            )}
          </svg>
          {r.label}
        </span>
      </div>
    ))}
    <svg class="chart mt-2.5 h-16 w-full" viewBox="0 0 300 64" preserveAspectRatio="none">
      <polyline
        points="0,50 25,46 50,48 75,38 100,41 125,30 150,34 175,22 200,27 225,18 250,21 275,12 300,15"
        fill="none"
        stroke="oklch(46% 0.085 215)"
        stroke-width="2"
      ></polyline>
    </svg>
  </ProductScreen>
  <ProductScreen dark class="kernel p-4 font-mono text-[0.74rem]">
    <p class="opacity-70">$ sha256sum -c minikernel-0.4.2.iso.sha256</p>
    <p>
      minikernel-0.4.2.iso: <span class="text-[oklch(80%_0.15_150)]">OK</span>
    </p>
    <p>[ 0.000] MiniKernel 0.4.2</p>
    <p>[ 0.031] planificador: round robin, 4 tareas</p>
  </ProductScreen>
  <ProductScreen class="incident p-4">
    <svg viewBox="0 0 320 120" class="block h-auto w-full text-[0.72rem]">
      <path d="M20 100H310" stroke="oklch(88% 0.008 240)"></path>
      <path
        d="M20 92 60 90 90 91 110 88 120 30 135 22 150 26 165 66 180 85 200 89 240 90 280 88 310 89"
        fill="none"
        stroke="oklch(22% 0.02 245)"
        stroke-width="2"
      ></path>
      <path d="M120 14V100" stroke="oklch(55% 0.19 27)" stroke-dasharray="3 3"></path>
      <path d="M165 14V100" stroke="oklch(46% 0.085 215)" stroke-dasharray="3 3"></path>
      <text x="116" y="12" text-anchor="end" fill="oklch(45% 0.015 245)">
        alerta 14:02
      </text>
      <text x="169" y="12" fill="oklch(45% 0.015 245)">
        mitigado 14:19
      </text>
    </svg>
  </ProductScreen>
</div>

<style>
  .wall {
    position: absolute;
    visibility: hidden;
    transform-origin: 0 0;
  }
  :global(html:not(.js)) .wall {
    display: none;
  }
  .wall > :global(*) {
    position: absolute;
  }
  .wall > :global(.sea) {
    top: 18%;
    left: 6%;
    width: 74%;
    max-width: 30rem;
  }
  .wall > :global(.kernel) {
    top: 7%;
    left: 34%;
    width: 64%;
    max-width: 26rem;
  }
  .wall > :global(.incident) {
    top: 56%;
    left: 26%;
    width: 66%;
    max-width: 26rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 3.5rem 5.5rem;
    gap: 8px;
    align-items: center;
    border-bottom: 1px solid oklch(0% 0 0 / 0.06);
    padding: 8px 0;
  }
  @media (max-width: 820px) {
    .wall > :global(.sea) {
      top: 6%;
      left: 4%;
      width: 86%;
    }
    .wall > :global(.kernel),
    .wall > :global(.incident),
    .chart {
      display: none;
    }
  }
</style>
