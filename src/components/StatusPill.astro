---
/** Real state (availability, severity), encoded as shape + color + label (WCAG 1.4.1). */
interface Props {
  status: 'ok' | 'warn' | 'critical';
  label: string;
}

const { status, label } = Astro.props;

const tone = {
  ok: 'text-ok',
  warn: 'text-warn',
  critical: 'text-critical',
}[status];
---

<span class="inline-flex items-center gap-2 rounded-sm border border-line bg-surface px-2.5 py-1 font-mono text-xs tracking-[0.06em] text-ink uppercase">
  <svg class:list={['size-2.5 shrink-0', tone]} viewBox="0 0 10 10" aria-hidden="true">
    {status === 'ok' && <circle cx="5" cy="5" r="4.5" fill="currentColor" />}
    {status === 'warn' && <path d="M5 0.5 9.5 9.5H0.5Z" fill="currentColor" />}
    {status === 'critical' && <rect x="1" y="1" width="8" height="8" fill="currentColor" />}
  </svg>
  {label}
</span>
