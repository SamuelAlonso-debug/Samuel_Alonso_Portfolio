---
import type { Locale } from '../i18n/config';
import { pathFor, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  routeKey?: RouteKey | undefined;
}

const { locale, routeKey } = Astro.props;
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-300 flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
    <a
      href={pathFor('home', locale)}
      aria-label={t(locale, 'header.home')}
      class="inline-flex min-h-11 items-center font-semibold tracking-tight text-ink no-underline"
    >
      Samuel Alonso
    </a>
    <div class="flex items-center gap-2">
      {routeKey && <LangSwitch locale={locale} routeKey={routeKey} />}
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
