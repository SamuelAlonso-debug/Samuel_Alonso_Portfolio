---
import type { Locale } from '../i18n/config';
import { pathFor, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  routeKey?: RouteKey | undefined;
}

const { locale, routeKey } = Astro.props;
---

<header class="fixed inset-x-3 top-3 z-40 flex items-center justify-between gap-1 rounded-full bg-paper/70 py-1.5 pr-1.5 pl-5 whitespace-nowrap shadow-float backdrop-blur-md sm:inset-x-auto sm:left-1/2 sm:-translate-x-1/2">
  <a
    href={pathFor('home', locale)}
    aria-label={t(locale, 'header.home')}
    class="mr-3 inline-flex min-h-10 items-center font-bold tracking-tight text-ink no-underline"
  >
    Samuel Alonso
  </a>
  <div class="flex items-center gap-1">
    {routeKey && <LangSwitch locale={locale} routeKey={routeKey} />}
    <ThemeToggle locale={locale} />
  </div>
</header>
