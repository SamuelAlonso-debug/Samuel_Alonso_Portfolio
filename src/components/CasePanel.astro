---
/** Case panel for the home track: cover on a palette backdrop, title, result and proofs. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProductScreen from './ProductScreen.astro';

interface Props {
  entry: CollectionEntry<'cases'>;
  index: number;
  total: number;
}

const { entry, index, total } = Astro.props;
const { title, summary, evidence, cover } = entry.data;
const surfaces = ['petrol', 'mist', 'ink'] as const;
const pad = (n: number) => String(n).padStart(2, '0');

// 16 px stroke icons per evidence kind.
const icons = {
  demo: '<path d="M6 3.5h6.5V10M12.25 3.75 3.5 12.5"/>',
  repo: '<circle cx="4.5" cy="3.5" r="1.75"/><circle cx="4.5" cy="12.5" r="1.75"/><circle cx="11.5" cy="5.5" r="1.75"/><path d="M4.5 5.25v5.5M11.5 7.25c0 2.5-3 2.5-6.2 3.9"/>',
  video: '<rect x="1.75" y="3" width="12.5" height="10" rx="2"/><path d="M6.75 6v4l3.25-2z"/>',
  testimonial:
    '<path d="M2.5 12.5c0-4 1-6.5 3.5-8M2.7 9h2.8v3.5H2.7zM9.5 12.5c0-4 1-6.5 3.5-8M9.7 9h2.8v3.5H9.7z"/>',
  artifact:
    '<path d="M4 1.75h5.25L12.5 5v9.25H4z"/><path d="M9.25 1.75V5h3.25M6 8.25h4.5M6 11h4.5"/>',
  metric: '<path d="M2 13.75h12.25"/><path d="M3.5 11 6.5 7.5l2.5 2 4-5"/>',
} as const;
---

<article class="panel">
  <div class="media" data-surface={surfaces[(index - 1) % surfaces.length]}>
    <div class="media-inner">
      {cover && (
        <ProductScreen>
          <Image
            src={cover}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(max-width: 820px) 80vw, 40vw"
          />
        </ProductScreen>
      )}
    </div>
  </div>
  <div class="txt">
    <p class="idx">
      {pad(index)} / {pad(total)}
    </p>
    <h3>{title}</h3>
    <p class="result">{summary}</p>
    <ul class="proofs">
      {evidence.map((e) => {
        const Tag = e.url ? 'a' : 'span';
        return (
          <li>
            <Tag class="proof" href={e.url}>
              <svg viewBox="0 0 16 16" aria-hidden="true" set:html={icons[e.kind]} />
              {e.label}
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</article>

<style>
  .panel {
    flex: 0 0 min(78vw, 76rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 4vw;
    align-items: end;
    height: 66vh;
  }
  .media {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-xl);
    outline: 1px solid oklch(0% 0 0 / 0.06);
    outline-offset: -1px;
  }
  .media[data-surface='petrol'] {
    background: var(--petrol-field);
  }
  .media[data-surface='mist'] {
    background: var(--mist);
  }
  .media[data-surface='ink'] {
    background: var(--ink-field);
  }
  .media-inner {
    position: absolute;
    inset: 0 -8%;
    display: grid;
    place-items: center;
    padding: 0 15%;
  }
  .media-inner > :global(*) {
    width: 100%;
    max-width: 34rem;
  }
  .media-inner :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .txt {
    padding-bottom: 2vh;
  }
  .idx {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    max-width: 18ch;
    margin-top: 12px;
    font-size: clamp(1.9rem, 1.1rem + 1.8vw, 2.75rem);
    line-height: 1.06;
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  .result {
    max-width: 34ch;
    margin-top: 16px;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .proofs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .proof {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px 0 12px;
    border: 1px solid color-mix(in oklch, var(--ink) 50%, transparent);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }
  a.proof:active {
    scale: 0.96;
  }
  @media (hover: hover) and (pointer: fine) {
    a.proof:hover {
      background: color-mix(in oklch, var(--ink) 8%, transparent);
    }
  }
  .proof svg {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 820px), (prefers-reduced-motion: reduce) {
    .panel {
      flex-basis: auto;
      grid-template-columns: 1fr;
      gap: 28px;
      height: auto;
    }
    .media {
      height: 56vh;
    }
  }
  :global(html:not(.js)) .panel {
    flex-basis: auto;
    grid-template-columns: 1fr;
    height: auto;
  }
  :global(html:not(.js)) .media {
    height: 56vh;
  }
</style>
