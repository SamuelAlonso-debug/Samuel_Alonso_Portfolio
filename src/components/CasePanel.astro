---
/** Case panel for the home track: cover on a palette backdrop, title, result and proofs. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { caseHref } from '../lib/case-pages';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import Button from './Button.astro';
import { icons, surfaceOf } from './case-style';
import ProductScreen from './ProductScreen.astro';

interface Props {
  entry: CollectionEntry<'cases'>;
  locale: Locale;
  index: number;
  total: number;
}

const { entry, locale, index, total } = Astro.props;
const { title, summary, evidence, cover } = entry.data;
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class="panel">
  <div class="media" data-surface={surfaceOf(index - 1)}>
    <div class="media-inner">
      {cover && (
        <ProductScreen>
          <Image
            src={cover}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(max-width: 820px) 80vw, 40vw"
          />
        </ProductScreen>
      )}
    </div>
  </div>
  <div class="txt bubble">
    <p class="idx">
      {pad(index)} / {pad(total)}
    </p>
    <h3>{title}</h3>
    <p class="result">{summary}</p>
    <ul class="proofs">
      {evidence.map((e) => {
        const Tag = e.url ? 'a' : 'span';
        return (
          <li>
            <Tag class="proof" href={e.url}>
              <svg viewBox="0 0 16 16" aria-hidden="true" set:html={icons[e.kind]} />
              {e.label}
            </Tag>
          </li>
        );
      })}
    </ul>
    <p class="open">
      <Button href={caseHref(entry)} variant="ghost">
        {t(locale, 'cases.open')}
      </Button>
    </p>
  </div>
</article>

<style>
  .panel {
    flex: 0 0 min(78vw, 76rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 4vw;
    align-items: end;
    height: 66vh;
  }
  .media {
    position: relative;
    height: 100%;
    /* overflow clips the layout; clip-path keeps the corners round on composited children. */
    overflow: clip;
    clip-path: inset(0 round var(--radius-xl));
    border-radius: var(--radius-xl);
    outline: 1px solid oklch(0% 0 0 / 0.06);
    outline-offset: -1px;
  }
  .media[data-surface='petrol'] {
    background: var(--petrol-field);
  }
  .media[data-surface='mist'] {
    background: var(--mist);
  }
  .media[data-surface='ink'] {
    background: var(--ink-field);
  }
  .media-inner {
    position: absolute;
    inset: 0 -8%;
    display: grid;
    place-items: center;
    padding: 0 15%;
  }
  .media-inner > :global(*) {
    width: 100%;
    max-width: 34rem;
  }
  .media-inner :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .txt {
    padding-bottom: 2vh;
  }
  .idx {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    max-width: 18ch;
    margin-top: 12px;
    font-size: clamp(1.9rem, 1.1rem + 1.8vw, 2.75rem);
    line-height: 1.06;
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  .result {
    max-width: 34ch;
    margin-top: 16px;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .proofs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .proof {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px 0 12px;
    border: 1px solid color-mix(in oklch, var(--ink) 50%, transparent);
    border-radius: 999px;
    /* The header's glass, a shade toward the ink. */
    background: color-mix(
      in oklch,
      color-mix(in oklch, var(--paper), var(--ink) 6%) 70%,
      transparent
    );
    backdrop-filter: blur(12px);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }
  a.proof:active {
    scale: 0.96;
  }
  @media (hover: hover) and (pointer: fine) {
    a.proof:hover {
      background: color-mix(
        in oklch,
        color-mix(in oklch, var(--paper), var(--ink) 12%) 70%,
        transparent
      );
    }
  }
  .open {
    margin-top: 28px;
  }
  .proof svg {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 820px), (prefers-reduced-motion: reduce) {
    .panel {
      flex-basis: auto;
      grid-template-columns: 1fr;
      gap: 28px;
      height: auto;
    }
    .media {
      height: 56vh;
    }
  }
  :global(html:not(.js)) .panel {
    flex-basis: auto;
    grid-template-columns: 1fr;
    height: auto;
  }
  :global(html:not(.js)) .media {
    height: 56vh;
  }
</style>
