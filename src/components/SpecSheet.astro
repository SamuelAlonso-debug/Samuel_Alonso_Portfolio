---
/** Spec sheet: an engineering convention for summarizing a project. Every row is a fact. */
interface Item {
  label: string;
  value: string;
}

interface Props {
  id: string;
  title: string;
  items: Item[];
}

const { id, title, items } = Astro.props;
---

<section aria-labelledby={id} class="rounded-md border border-line bg-surface p-5 sm:p-6">
  <h2 id={id} class="font-mono text-xs tracking-[0.08em] text-muted uppercase">
    {title}
  </h2>
  <dl class="mt-5 grid gap-5">
    {items.map((item) => (
      <div class="grid gap-1">
        <dt class="font-mono text-xs tracking-[0.06em] text-muted uppercase">{item.label}</dt>
        <dd class="text-base text-ink">{item.value}</dd>
      </div>
    ))}
  </dl>
  <slot />
</section>
