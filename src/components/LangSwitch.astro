---
import { htmlLang, otherLocale, type Locale } from '../i18n/config';
import type { Paths } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  paths: Paths;
}

const { locale, paths } = Astro.props;
const target = otherLocale(locale);
---

<a
  href={paths[target]}
  hreflang={htmlLang[target]}
  lang={htmlLang[target]}
  aria-label={t(locale, 'lang.switchLabel')}
  data-lang-switch
  class="inline-flex min-h-10 items-center rounded-full px-3 text-sm text-muted no-underline transition-colors duration-150 hover:bg-ink/8 hover:text-ink"
>
  {t(locale, 'lang.switch')}
</a>
