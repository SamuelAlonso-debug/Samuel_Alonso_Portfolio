---
import Button from '../components/Button.astro';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
---

<Base
  locale="es"
  title={`${t('es', 'notFound.title')} · Samuel Alonso`}
  description={t('es', 'notFound.body')}
  noindex
>
  <div class="mx-auto max-w-300 px-5 pt-32 pb-20 sm:px-8 md:pt-40">
    <p class="text-sm text-muted">404</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight">{t('es', 'notFound.title')}</h1>
    <p class="mt-4 text-lg">{t('es', 'notFound.body')}</p>
    <p class="mt-2 text-lg text-muted" lang="en">
      {t('en', 'notFound.body')}
    </p>
    <p class="mt-8 flex flex-wrap gap-3">
      <Button href="/" variant="primary">
        {t('es', 'notFound.back')}
      </Button>
      <Button href="/en/" lang="en" hreflang="en">
        {t('en', 'notFound.back')}
      </Button>
    </p>
  </div>
</Base>
