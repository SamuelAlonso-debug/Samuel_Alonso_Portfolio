---
/**
 * Contact scene: the ink field rises with a curve that flattens (scenes.ts), the magnetic
 * "Book a call" orb, Querétaro time (contact.ts) and the form. Rendered only with a booking link.
 */
import ContactForm from '../../components/ContactForm.astro';
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { sampleCopy } from '../../samples/copy';

interface Props {
  locale: Locale;
  booking: string;
}

const { locale, booking } = Astro.props;
const email = 'samuelalonsodv@gmail.com';
---

<section
  id="contact"
  class="contact"
  data-tone="ink"
  data-tone-at="top"
  aria-labelledby="contact-title"
>
  <div class="curve" aria-hidden="true"></div>
  <div class="inner">
    <div>
      <h2 id="contact-title">{t(locale, 'contact.title')}</h2>
      <p class="lead">{sampleCopy[locale].contact}</p>
      <div class="row">
        <a class="orb magnetic" href={booking}>
          <svg class="cal" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="5" width="17" height="15.5" rx="3"></rect>
            <path d="M3.5 10h17M8 3v4M16 3v4"></path>
            <circle cx="12" cy="15" r="1.6"></circle>
          </svg>
          <span class="label">
            {t(locale, 'cta.book')}
            <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5 11 11 5M6 5h5v5"></path>
            </svg>
          </span>
          <span class="meta">{t(locale, 'cta.book.meta')}</span>
        </a>
        <div class="reach">
          <p class="reach-label">{t(locale, 'contact.write')}</p>
          <a class="mail" href={`mailto:${email}`}>
            {email}
          </a>
          <p class="clock" data-text={t(locale, 'contact.clock')}></p>
        </div>
      </div>
    </div>
    <ContactForm locale={locale} compact />
  </div>
</section>

<script>
  import '../../scripts/contact';
</script>

<style>
  /* Own ink field: the page tone switches only at the top, so --paper is still the field above.
     The footer takes the same field, so a fast scroll never shows the fading page tone. */
  .contact,
  :global(body:has(#contact) > footer) {
    --ink: var(--ink-scene-fg);
    --muted: var(--ink-scene-muted);
    --line: var(--ink-scene-line);
    --accent: var(--scene-accent);
    background: var(--ink-scene);
    color: var(--ink);
  }
  :global(body:has(#contact) > footer) {
    margin-top: 0;
  }
  .contact {
    position: relative;
    min-height: 100svh;
    padding: 34vh clamp(20px, 4vw, 64px) 16vh;
    overflow: clip;
  }
  /* The field above bulges into the ink. No JS or reduced motion: a straight edge. */
  .curve {
    display: none;
    position: absolute;
    top: -1px;
    right: -10vw;
    left: -10vw;
    height: 22vh;
    border-radius: 0 0 50% 50%;
    background: var(--paper);
    transform-origin: 50% 0;
    will-change: transform;
  }
  :global(html.js) .curve {
    display: block;
  }
  .inner {
    position: relative;
    display: grid;
    gap: 64px;
  }
  @media (min-width: 1000px) {
    .inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  h2 {
    max-width: 11ch;
    font-size: clamp(2.8rem, 1.2rem + 6vw, 7.5rem);
    line-height: 0.94;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .lead {
    max-width: 32ch;
    margin-top: 24px;
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 40px;
    margin-top: 48px;
  }
  .orb {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    width: 176px;
    height: 176px;
    padding: 24px;
    border-radius: 50%;
    background: var(--action);
    color: var(--action-ink);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
    transition:
      scale 150ms ease-out,
      background-color 150ms ease-out;
  }
  .orb:active {
    scale: 0.96;
  }
  .orb svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cal {
    width: 28px;
    height: 28px;
  }
  .cal circle {
    fill: currentColor;
    stroke: none;
  }
  .arrow {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin-left: 2px;
    vertical-align: -0.05em;
    transition: transform 150ms ease-out;
  }
  .meta {
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.8;
  }
  @media (hover: hover) and (pointer: fine) {
    .orb:hover {
      background: var(--action-hover);
    }
    .orb:hover .arrow {
      transform: translate(2px, -2px);
    }
  }
  .reach {
    display: grid;
    gap: 4px;
  }
  .reach-label {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .mail {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }
  .clock {
    font-size: 0.95rem;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .curve {
      display: none;
    }
  }
</style>
