---
import Button from '../components/Button.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const profiles = [
  { label: 'GitHub', href: 'https://github.com/SamuelAlonso-debug' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/samuel-alonso-971094365' },
];
---

<Base
  locale={locale}
  routeKey="home"
  title={t(locale, 'meta.home.title')}
  description={t(locale, 'meta.home.description')}
>
  <section aria-labelledby="hero-title" class="mx-auto max-w-300 px-5 pt-32 pb-20 sm:px-8 md:pt-40">
    <h1
      id="hero-title"
      class="text-[clamp(3rem,1.6rem+7vw,8rem)] leading-[0.9] font-bold tracking-[-0.035em]"
    >
      Samuel Alonso
    </h1>
    <p class="mt-6 text-xl text-muted">{t(locale, 'home.role')}</p>
    <p class="mt-6 max-w-[62ch] text-lg">{t(locale, 'home.lede')}</p>
    <h2 class="mt-12 text-sm text-muted">{t(locale, 'home.elsewhere')}</h2>
    <ul class="mt-3 flex flex-wrap gap-3">
      {profiles.map((profile) => (
        <li>
          <Button href={profile.href} rel="me noopener">
            {profile.label}
          </Button>
        </li>
      ))}
    </ul>
  </section>
</Base>
