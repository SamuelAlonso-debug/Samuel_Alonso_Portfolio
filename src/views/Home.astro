---
import SpecSheet from '../components/SpecSheet.astro';
import StatusPill from '../components/StatusPill.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = [
  { label: t(locale, 'ficha.role'), value: t(locale, 'home.role') },
  { label: t(locale, 'ficha.focus'), value: t(locale, 'ficha.focusValue') },
  { label: t(locale, 'ficha.base'), value: t(locale, 'ficha.baseValue') },
];

const profiles = [
  { label: 'GitHub', href: 'https://github.com/SamuelAlonso-debug' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/samuel-alonso-971094365' },
];
---

<Base
  locale={locale}
  routeKey="home"
  title={t(locale, 'meta.home.title')}
  description={t(locale, 'meta.home.description')}
>
  <div class="mx-auto grid max-w-300 gap-10 px-4 py-14 sm:px-6 md:py-20 lg:grid-cols-12 lg:gap-12">
    <section aria-labelledby="hero-title" class="lg:col-span-7">
      <StatusPill status="warn" label={t(locale, 'home.status')} />
      <h1 id="hero-title" class="mt-6 text-4xl font-semibold tracking-tight">
        Samuel Alonso
      </h1>
      <p class="mt-3 text-xl text-muted">{t(locale, 'home.role')}</p>
      <p class="mt-6 max-w-[62ch] text-lg">{t(locale, 'home.lede')}</p>
    </section>

    <div class="lg:col-span-4 lg:col-start-9">
      <SpecSheet id="spec-sheet-home" title={t(locale, 'home.ficha')} items={items}>
        <h3 class="mt-6 font-mono text-xs tracking-[0.06em] text-muted uppercase">
          {t(locale, 'home.elsewhere')}
        </h3>
        <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
          {profiles.map((profile) => (
            <li>
              <a
                href={profile.href}
                rel="me noopener"
                class="inline-flex min-h-11 items-center text-accent underline"
              >
                {profile.label}
              </a>
            </li>
          ))}
        </ul>
      </SpecSheet>
    </div>
  </div>
</Base>
