---
import { getCollection } from 'astro:content';
import {
  PUBLIC_BOOKING_URL as booking,
  PUBLIC_TURNSTILE_SITE_KEY as siteKey,
} from 'astro:env/client';
import Button from '../components/Button.astro';
import type { Locale } from '../i18n/config';
import { routes } from '../i18n/routes';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { getCases } from '../lib/case-pages';
import { allowTurnstile } from '../lib/contact';
import ScreenWall from '../samples/ScreenWall.astro';
import { sampleCopy } from '../samples/copy';
import About from './home/About.astro';
import Cases from './home/Cases.astro';
import Contact from './home/Contact.astro';
import HowIWork from './home/HowIWork.astro';
import Testimonials from './home/Testimonials.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = sampleCopy[locale];
const words = copy.statement.split(' ');
const { cases } = await getCases(locale);
const hasCases = cases.length > 0;
// Most recent first.
const testimonials = (
  await getCollection('testimonials', ({ id }) => id.startsWith(`${locale}/`))
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
// No booking link: no contact scene and no "Book a call" anywhere.
const call = booking ? { id: 'contact', label: t(locale, 'cta.book') } : undefined;
// The contact scene holds the form.
if (booking && siteKey) allowTurnstile(Astro.csp);
---

<Base
  locale={locale}
  paths={routes.home}
  title={t(locale, 'meta.home.title')}
  description={t(locale, 'meta.home.description')}
  tone="ink"
  sections={[
    ...(hasCases ? [{ id: 'cases', label: t(locale, 'cases.title') }] : []),
    { id: 'about', label: t(locale, 'nav.about') },
    { id: 'how', label: t(locale, 'how.title') },
    ...(testimonials.length > 0
      ? [{ id: 'testimonials', label: t(locale, 'nav.testimonials') }]
      : []),
    ...(call ? [{ id: 'contact', label: t(locale, 'nav.contact') }] : []),
  ]}
  cta={call}
>
  <section id="hero" class="hero" data-scene data-tone="ink" aria-labelledby="hero-name">
    <div class="stage">
      <div id="hero-photo" class="photo bg-surface">
        <ScreenWall />
        <div id="hero-veil" class="veil"></div>
      </div>
      <h1 id="hero-name" class="name">
        <span>Samuel</span> <span>Alonso</span>
      </h1>
      <div id="hero-copy" class="copy bubble">
        <p class="font-medium text-muted">{t(locale, 'home.role')}</p>
        <p class="headline">{copy.headline}</p>
        {(call || hasCases) && (
          <p class="actions">
            {call && (
              <Button href="#contact" variant="primary" class="magnetic">
                <span>{call.label}</span>
              </Button>
            )}
            {hasCases && (
              <a class="text-link" href="#cases">
                {t(locale, 'hero.cases')}
              </a>
            )}
          </p>
        )}
      </div>
      <div class="dock" aria-hidden="true">
        <div id="dock-name" class="dock-name">
          <span>Samuel</span>
          <span>Alonso</span>
        </div>
        <div id="dock-copy" class="dock-copy"></div>
      </div>
    </div>
  </section>

  <section
    id="statement"
    class="statement"
    data-scene
    data-tone="ink"
    aria-label={t(locale, 'home.statement')}
  >
    <div class="stage">
      <p>
        {words.map((word, i) => (
          <>
            <span class="w">{word}</span>
            {i < words.length - 1 && ' '}
          </>
        ))}
      </p>
    </div>
  </section>

  <Cases locale={locale} cases={cases} />
  <About locale={locale} />
  <HowIWork locale={locale} />
  <Testimonials locale={locale} testimonials={testimonials} />
  {booking && <Contact locale={locale} booking={booking} />}
</Base>

<script>
  import '../scripts/scenes';
</script>

<style>
  /* Off-screen, non-pinned scenes skip style, layout and paint until they near the viewport.
     Pinned scenes measure their content (scenes.ts) and How I work fades rows in on
     intersection, so they always render. "auto" keeps the
     last real size, so the scrollbar settles after the first pass. */
  :global(#about),
  :global(#contact) {
    content-visibility: auto;
    contain-intrinsic-size: auto 100svh;
  }
  :global(body > footer) {
    content-visibility: auto;
    contain-intrinsic-size: auto 360px;
  }
  section {
    --pad: clamp(20px, 4vw, 64px);
    position: relative;
  }
  /* Pinned scroll runs, 15% shorter than the v3 prototype: height = run + 100vh. */
  .hero {
    height: 213vh;
  }
  .statement {
    height: 196vh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .photo,
  .dock {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .dock {
    visibility: hidden;
    pointer-events: none;
  }
  .veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    background: linear-gradient(
      to top,
      var(--paper) 20%,
      color-mix(in oklch, var(--paper) 70%, transparent) 48%,
      transparent 78%
    );
  }
  /* The neon strands show through the hero window while the layer runs (scripts/strands.ts). */
  :global(html.strands-on) .photo {
    background: transparent;
  }
  :global(html.strands-on) .veil {
    display: none;
  }
  .name,
  .dock-name {
    position: absolute;
    left: var(--pad);
    line-height: 0.84;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .name {
    bottom: 5vh;
    z-index: 2;
    font-size: clamp(4.6rem, 15vw, 16rem);
    transform-origin: 0 0;
  }
  .name span,
  .dock-name span {
    display: block;
  }
  .copy {
    position: absolute;
    right: var(--pad);
    bottom: 7vh;
    z-index: 3;
    width: min(31rem, 40vw);
  }
  .headline {
    margin-top: 10px;
    font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2.1rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    margin-top: 24px;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 6px;
    text-decoration-thickness: 1.5px;
  }
  .dock-name {
    top: 19vh;
    font-size: clamp(2.6rem, 5.6vw, 6rem);
  }
  .dock-copy {
    position: absolute;
    top: calc(19vh + 1.68 * clamp(2.6rem, 5.6vw, 6rem) + 36px);
    left: var(--pad);
    width: min(31rem, 40vw);
  }
  .statement .stage {
    display: grid;
    align-items: center;
    padding-inline: var(--pad);
  }
  .statement p {
    max-width: 20ch;
    font-size: clamp(2rem, 1rem + 4.4vw, 5.25rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  /* Dimmed words keep ≥3:1 on the ink field (large text). */
  /* Unlit words keep large-text contrast (--scene-dim per theme); scenes.ts sets --lit. */
  :global(html.js) .w {
    opacity: calc(var(--scene-dim) + (1 - var(--scene-dim)) * var(--lit, 0));
  }
  @media (max-width: 820px) {
    .name {
      bottom: 4vh;
      font-size: clamp(4rem, 21vw, 8rem);
    }
    .copy {
      right: var(--pad);
      bottom: calc(4vh + 1.68 * clamp(4rem, 21vw, 8rem) + 28px);
      left: var(--pad);
      width: auto;
    }
    .dock-name {
      top: 13vh;
      font-size: clamp(2.4rem, 11vw, 3.4rem);
    }
    .dock-copy {
      top: calc(13vh + 1.68 * clamp(2.4rem, 11vw, 3.4rem) + 20px);
      width: calc(100vw - 2 * var(--pad));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero,
    .statement {
      height: auto;
    }
    .stage {
      position: relative;
      height: auto;
      min-height: 100svh;
    }
  }
</style>
