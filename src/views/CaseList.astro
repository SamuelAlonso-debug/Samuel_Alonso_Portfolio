---
/** All published cases of a locale, featured first. */
import type { Locale } from '../i18n/config';
import { routes } from '../i18n/routes';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { caseHref, type CasePair } from '../lib/case-pages';

interface Props {
  locale: Locale;
  pairs: CasePair[];
}

const { locale, pairs } = Astro.props;
const title = `${t(locale, 'cases.title')} · Samuel Alonso`;
---

<Base locale={locale} paths={routes.cases} title={title} description={t(locale, 'cases.intro')}>
  <div class="mx-auto max-w-300 px-5 pt-32 pb-24 sm:px-8 md:pt-40">
    <h1 class="text-4xl font-bold tracking-tight">{t(locale, 'cases.title')}</h1>
    <p class="mt-5 text-xl text-muted">{t(locale, 'cases.intro')}</p>
    <ul class="mt-16 border-b border-line">
      {pairs.map((pair) => (
        <li class="border-t border-line py-8">
          <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
            <a href={caseHref(pair[locale])}>{pair[locale].data.title}</a>
          </h2>
          <p class="mt-3 max-w-[60ch] text-lg text-muted">{pair[locale].data.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
