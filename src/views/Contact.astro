---
/**
 * Contact page. The form needs JS (the Action runs in the Worker; the page is static) and a
 * Turnstile site key; without either, the email and booking link are still visible.
 */
import {
  PUBLIC_BOOKING_URL as booking,
  PUBLIC_TURNSTILE_SITE_KEY as siteKey,
} from 'astro:env/client';
import ContactForm from '../components/ContactForm.astro';
import type { Locale } from '../i18n/config';
import { routes } from '../i18n/routes';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { allowTurnstile } from '../lib/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const email = 'samuelalonsodv@gmail.com';
if (siteKey) allowTurnstile(Astro.csp);

const copy = {
  es: {
    lead: 'Cuéntame qué necesitas. Te respondo en un máximo de dos días hábiles.',
    direct: 'También puedes escribirme a',
    book: 'o agendar una llamada',
  },
  en: {
    lead: 'Tell me what you need. I reply within two business days.',
    direct: 'You can also email me at',
    book: 'or book a call',
  },
}[locale];
const title = t(locale, 'nav.contact');
---

<Base
  locale={locale}
  paths={routes.contact}
  title={`${title} · Samuel Alonso`}
  description={copy.lead}
>
  <div class="mx-auto max-w-300 px-5 pt-32 pb-24 sm:px-8 md:pt-40">
    <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
    <p class="mt-5 max-w-[48ch] text-xl text-muted">{copy.lead}</p>
    <p class="mt-3 max-w-[62ch] text-lg">
      {copy.direct}{' '}
      <a class="underline" href={`mailto:${email}`}>
        {email}
      </a>
      {booking && (
        <>
          {copy.book}{' '}
          <a class="underline" href={booking}>
            {t(locale, 'cta.book')}
          </a>
        </>
      )}
      .
    </p>
    <ContactForm locale={locale} class="mt-12 max-w-[40rem]" />
  </div>
</Base>
