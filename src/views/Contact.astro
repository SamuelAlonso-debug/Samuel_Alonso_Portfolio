---
/**
 * Contact page. The form needs JS (the Action runs in the Worker; the page is static) and a
 * Turnstile site key; without either, the email and booking link are still visible.
 */
import {
  PUBLIC_BOOKING_URL as booking,
  PUBLIC_TURNSTILE_SITE_KEY as siteKey,
} from 'astro:env/client';
import type { Locale } from '../i18n/config';
import { routes } from '../i18n/routes';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { topics } from '../lib/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const email = 'samuelalonsodev@gmail.com';
const turnstile = 'https://challenges.cloudflare.com';

// Turnstile is allowed only on this page.
if (siteKey) {
  Astro.csp?.insertScriptResource(turnstile);
  Astro.csp?.insertDirective(`frame-src ${turnstile}`);
}

const copy = {
  es: {
    lead: 'Cuéntame qué necesitas. Te respondo en un máximo de dos días hábiles.',
    direct: 'También puedes escribirme a',
    book: 'o agendar una llamada',
    name: 'Nombre',
    email: 'Correo',
    company: 'Empresa (opcional)',
    topic: 'Tema',
    topics: {
      review: 'Revisión técnica',
      project: 'Proyecto nuevo',
      support: 'Soporte o mejora',
      other: 'Otro',
    },
    message: 'Mensaje',
    send: 'Enviar mensaje',
    sending: 'Enviando…',
    privacy: 'Uso tus datos solo para responderte. Detalles en el',
    privacyLink: 'aviso de privacidad',
    sent: 'Mensaje enviado. Te respondo pronto.',
    errors: {
      name: 'Escribe tu nombre (2 a 100 caracteres).',
      email: 'Escribe un correo válido.',
      company: 'El nombre de la empresa es demasiado largo.',
      topic: 'Elige un tema.',
      message: 'El mensaje debe tener entre 20 y 4000 caracteres.',
      turnstile: 'Completa la verificación antes de enviar.',
      rate: 'Demasiados envíos. Espera un minuto e inténtalo de nuevo.',
      failed: `No se pudo enviar. Escríbeme a ${email}.`,
    },
  },
  en: {
    lead: 'Tell me what you need. I reply within two business days.',
    direct: 'You can also email me at',
    book: 'or book a call',
    name: 'Name',
    email: 'Email',
    company: 'Company (optional)',
    topic: 'Topic',
    topics: {
      review: 'Technical review',
      project: 'New project',
      support: 'Support or improvement',
      other: 'Other',
    },
    message: 'Message',
    send: 'Send message',
    sending: 'Sending…',
    privacy: 'I use your data only to reply. Details in the',
    privacyLink: 'privacy notice',
    sent: 'Message sent. I will reply soon.',
    errors: {
      name: 'Enter your name (2 to 100 characters).',
      email: 'Enter a valid email.',
      company: 'The company name is too long.',
      topic: 'Pick a topic.',
      message: 'The message must be 20 to 4000 characters.',
      turnstile: 'Complete the check before sending.',
      rate: 'Too many submissions. Wait a minute and try again.',
      failed: `It could not be sent. Email me at ${email}.`,
    },
  },
}[locale];
const title = t(locale, 'nav.contact');
const field =
  'mt-2 block w-full rounded-md border border-muted/40 bg-transparent px-3 py-2.5 text-lg';
---

<Base
  locale={locale}
  paths={routes.contact}
  title={`${title} · Samuel Alonso`}
  description={copy.lead}
>
  <div class="mx-auto max-w-300 px-5 pt-32 pb-24 sm:px-8 md:pt-40">
    <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
    <p class="mt-5 max-w-[48ch] text-xl text-muted">{copy.lead}</p>
    <p class="mt-3 max-w-[62ch] text-lg">
      {copy.direct}{' '}
      <a class="underline" href={`mailto:${email}`}>
        {email}
      </a>
      {booking && (
        <>
          {copy.book}{' '}
          <a class="underline" href={booking}>
            {t(locale, 'cta.book')}
          </a>
        </>
      )}
      .
    </p>

    {siteKey && (
      <form
        id="contact-form"
        class="mt-12 grid max-w-[40rem] gap-6"
        novalidate
        hidden
        data-errors={JSON.stringify(copy.errors)}
        data-sending={copy.sending}
        data-sent={copy.sent}
      >
        <label class="block">
          {copy.name}
          <input
            class={field}
            name="name"
            autocomplete="name"
            required
            minlength="2"
            maxlength="100"
          />
        </label>
        <label class="block">
          {copy.email}
          <input
            class={field}
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
          />
        </label>
        <label class="block">
          {copy.company}
          <input class={field} name="company" autocomplete="organization" maxlength="100" />
        </label>
        <label class="block">
          {copy.topic}
          <select class={field} name="topic" required>
            {topics.map((topic) => (
              <option value={topic}>{copy.topics[topic]}</option>
            ))}
          </select>
        </label>
        <label class="block">
          {copy.message}
          <textarea
            class={field}
            name="message"
            rows="6"
            required
            minlength="20"
            maxlength="4000"
          />
        </label>
        {/* Honeypot: off-screen and out of the tab order. */}
        <label class="sr-only" aria-hidden="true">
          Website
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
        <div class="cf-turnstile" data-sitekey={siteKey} data-language={locale}></div>
        <p class="text-sm text-muted">
          {copy.privacy}{' '}
          <a class="underline" href={routes.privacy[locale]}>
            {copy.privacyLink}
          </a>
          .
        </p>
        <div>
          <button
            type="submit"
            class="rounded-full bg-action px-6 py-3 font-semibold text-action-ink hover:bg-action-hover"
          >
            {copy.send}
          </button>
        </div>
        <p class="status text-lg" role="status" aria-live="polite"></p>
      </form>
    )}
  </div>
  {siteKey && <script is:inline src={`${turnstile}/turnstile/v0/api.js`} async defer></script>}
</Base>

<script>
  import '../scripts/contact-form';
</script>
